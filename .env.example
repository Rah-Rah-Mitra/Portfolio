GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it
VITE_POSTHOG_KEY=your_posthog_project_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_UI_HOST=https://us.posthog.com
VITE_ANALYTICS_DEBUG=false
POSTHOG_OTLP_LOGS_URL=https://us.i.posthog.com/otlp/v1/logs
POSTHOG_API_KEY=your_server_side_posthog_token_here
# Gates the MCP job-search tools (preferences + application tracker). Under 24
# characters they stay off, so a placeholder cannot leave the tracker open.
PORTFOLIO_JOB_TOKEN=a_long_random_string_you_generate
# Storage for those tools. KV_REST_API_URL / KV_REST_API_TOKEN are accepted as a
# fallback, which is what the Vercel Marketplace Upstash integration may inject.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_standard_token
