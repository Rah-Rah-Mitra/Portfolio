# Estate pack files are named by a hash of their content; core.autocrlf=true
# must never rewrite them, or a fresh checkout stops matching its own names.
public/estate/** -text
tests/fixtures/estate/** -text
*.glb binary
*.gz binary
lib/estate/catalogue.generated.ts text eol=lf
# The desk drawing set is generated text, compared byte for byte (tests/drawing-set).
lib/drawings/**/*.generated.ts text eol=lf
