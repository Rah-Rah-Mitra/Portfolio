{
  "name": "personal-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "dev:vite": "vite",
    "api": "node server.mjs",
    "build": "vite build && node scripts/prerender-semantic.mjs && node scripts/check-bundle.mjs",
    "snapshot": "node scripts/export-portfolio-snapshot.mjs",
    "resume:lint": "node scripts/resume/lint_pool.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "comfy:smoke": "node scripts/comfyui/smoke-test.mjs",
    "comfy:field-media": "node scripts/comfyui/generate-field-media.mjs",
    "media:encode": "node scripts/media/encode-support-video.mjs",
    "media:check": "node scripts/media/check-budgets.mjs",
    "media:audio": "node scripts/media/generate-audio-sprite.mjs",
    "media:provenance": "node scripts/media/validate-provenance.mjs",
    "estate:setup": "npm --prefix scripts/estate ci",
    "estate:pack": "npm --prefix scripts/estate run pack --",
    "estate:check": "node scripts/estate/check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@posthog/react": "^1.9.0",
    "@vercel/analytics": "^2.0.1",
    "docx": "^9.7.1",
    "matter-js": "0.19.0",
    "mcp-handler": "^2.1.1",
    "pdfkit": "^0.20.2",
    "posthog-js": "^1.373.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
